# =====================================================
# Alpha Report Lab - .gitignore
# =====================================================

# --- Secrets / environment files ---
# Never commit any .env file with real values. Track only *.example files.
.env
.env.*
!.env.example
!**/.env.example
!**/.env.local.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/
.tox/

# --- Node.js / Next.js ---
node_modules/
.next/
out/
.turbo/
.swc/
*.tsbuildinfo
next-env.d.ts

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- OS / temp ---
*.tmp
*.bak
*.orig

# --- App-specific runtime artifacts ---
# Local report cache, if any
reports.json
*.pid
