        "title": "Order Summary by Product Category",
        "type": "data",
        "query": "data\n  record(ProductCategory=\"Laptop\", TotalOrders=12540, AvgProcessingTime=1.2, Shipped=11890, Delayed=350, Canceled=300, SuccessRate=97.6),\n  record(ProductCategory=\"Desktop\", TotalOrders=8750, AvgProcessingTime=2.1, Shipped=8550, Delayed=120, Canceled=80, SuccessRate=99.08),\n  record(ProductCategory=\"Monitor\", TotalOrders=15200, AvgProcessingTime=0.8, Shipped=15100, Delayed=50, Canceled=50, SuccessRate=99.67),\n  record(ProductCategory=\"Accessory\", TotalOrders=22430, AvgProcessingTime=0.5, Shipped=22310, Delayed=25, Canceled=95, SuccessRate=99.57),\n  record(ProductCategory=\"Laptop\", TotalOrders=50, AvgProcessingTime=5.5, Shipped=10, Delayed=35, Canceled=5, SuccessRate=20.0)\n\n| sort SuccessRate asc\n| filter in(ProductCategory, $ProductCategory)",
